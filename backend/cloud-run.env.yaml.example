# Template for: gcloud run deploy --env-vars-file
#
# Setup (from the backend/ directory):
#   cp cloud-run.env.yaml.example secrets/cloud-run.env.yaml
#   # edit secrets/cloud-run.env.yaml with real values (that path is gitignored)
#
# Quote values that contain &, ?, #, or spaces. DATABASE_URL almost always needs quotes.

DATABASE_URL: "REPLACE_WITH_SUPABASE_POOLER_OR_DIRECT_URL"
LLM_MODEL: "REPLACE_WITH_MODEL_ID"
LLM_PROVIDER: "openai"

# Required for embeddings and (when LLM_PROVIDER is openai) chat:
OPENAI_API_KEY: "REPLACE_ME"

# Uncomment and set only if you use that provider for LLM_PROVIDER:
# ANTHROPIC_API_KEY: "REPLACE_ME"
# GOOGLE_API_KEY: "REPLACE_ME"

# Security — chat / vote: browser Origin must match one of these (widget shell hosts, comma-separated).
# Example: Firebase default + custom domain for the same Hosting site:
WIDGET_ALLOWED_ORIGINS: "https://civic-core-widget.web.app,https://app.civiccore.ai"
# Local Live Server (optional on your laptop .env only):
# WIDGET_ALLOWED_ORIGINS: "http://127.0.0.1:5500,http://localhost:5500"

# Do not set PORT — Cloud Run sets it automatically.

# Debug only: if the container exits before listening, migrations may be failing.
# Set to "true" to start the API without running migrate (run `yarn db:migrate:deploy` from your laptop first).
# SKIP_DB_MIGRATE: "true"

# Production: disable /crawl so crawlee is never loaded (use the crawler only on your laptop).
DISABLE_CRAWL: "true"
