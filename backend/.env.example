# Database
DATABASE_URL="postgresql://..."

# LLM (OpenAI only)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Ignored for gpt-5 / o-series (those models reject temperature).
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
# GPT-5.x reasoning depth: none | minimal | low | medium | high | xhigh (default none for low latency).
# Non-none values need the Responses API (enabled in chat.service) when tools are bound.
LLM_REASONING_EFFORT=none

# Security (optional)
# Encrypt message content at rest. Must be 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MESSAGE_ENCRYPTION_KEY=

# Chat: widget shell origins (comma-separated). Must include every host where widget.html is served.
# See backend README / cloud-run.env.yaml.example.
WIDGET_ALLOWED_ORIGINS="https://civic-core-widget.web.app,https://app.civiccore.ai"

# Local only: enables GET /dev/jurisdictions for widget/demo.html jurisdiction picker.
# Never set this on Cloud Run / production.
# ENABLE_DEV_ROUTES=true

# ── Voice AI (OpenAI Realtime + SIP) ──────────────────────────────────────────
# Enable voice routes (/voice/*). Requires OPENAI_API_KEY.
# VOICE_ENABLED=true
#
# Point Twilio SIP trunk at OpenAI; configure OpenAI project webhook →
# POST {PUBLIC_BASE_URL}/voice/openai/webhook (realtime.call.incoming)
# OPENAI_WEBHOOK_SECRET=whsec_...
# VOICE_REALTIME_MODEL=gpt-realtime-2.1
# VOICE_REALTIME_VOICE=marin

# Logo storage (local dev default — no GCS required)
# LOGO_STORAGE=local
# LOGO_PUBLIC_BASE_URL=http://localhost:4000

# Production jurisdiction sync (LOGO_STORAGE=gcs uploads logos to bucket)
# LOGO_STORAGE=gcs
# GCS_ASSETS_BUCKET=civic-core-assets
# GCS_LOGO_PREFIX=logos
