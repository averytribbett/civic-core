# Database
DATABASE_URL="postgresql://..."

# LLM (OpenAI, Anthropic, or Google)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Security (optional)
# Encrypt message content at rest. Must be 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MESSAGE_ENCRYPTION_KEY=

# Per-source allowed origins (comma-separated). Requests must come from these URLs.
# Format: https://example.com, https://www.example.com, or *.example.com for subdomains
CHISAGO_COUNTY_MN_ORIGINS=https://chisagocounty.us,https://www.chisagocounty.us

# CORS: comma-separated allowed origins (e.g. https://chisagocounty.us,https://www.chisagocounty.us)
# If unset, CORS allows all origins.
# CORS_ALLOWED_ORIGINS=
