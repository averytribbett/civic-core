{
  "name": "civic-core-backend",
  "version": "1.0.0",
  "description": "Backend logic",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "prisma:studio": "npx prisma studio --config ./prisma.config.ts",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:production": "npx prisma migrate deploy",
    "lint:fix": "eslint src prisma.config.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma.config.ts\"",
    "lint": "yarn lint:fix && yarn format"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/anthropic": "^1.3.12",
    "@langchain/core": "^1.1.29",
    "@langchain/google-genai": "^2.1.21",
    "@langchain/langgraph": "^1.1.2",
    "@langchain/openai": "^1.2.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "crawlee": "^3.15.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "langchain": "^1.2.13",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.17.1",
    "pgvector": "^0.2.1",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/cors": "^2.8.19",
    "dotenv": "^17.2.3",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
