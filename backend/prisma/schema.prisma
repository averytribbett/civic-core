// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JurisdictionType {
  country
  state
  county
  city
  township
  village
}

/// Coarse document category for RAG soft re-ranking (citizen pages vs meeting dumps).
enum DocumentKind {
  html_page
  pdf
  agenda
  minutes
  other
}

model Jurisdiction {
  id            String @id @default(uuid())
  /// Widget/API source slug (e.g. chisago_county_mn); external tenant identifier only
  source        String            @unique
  name          String
  type          JurisdictionType
  email         String
  phoneNumber   String?
  prompt        String            @db.Text
  /// When true, included in the weekly Cloud Run crawl-sync job
  enabled       Boolean           @default(false)
  /// Seed URL for crawls (e.g. https://www.chisagocountymn.gov/)
  crawlUrl      String?
  /// Official FAQ page used to extract cached questions after each crawl
  faqUrl        String?
  lastCrawlAt   DateTime?
  lastCrawlStatus String?
  lastCrawlError  String?         @db.Text
  /// Public logo URL (local /assets/logos/ in dev, GCS in prod)
  logoUrl       String?
  /// Hex brand color for widget theme (e.g. #005596)
  themeColor    String?
  /// E.164 inbound AI line (e.g. +16515550100) for Twilio/OpenAI SIP routing
  inboundPhoneNumber String? @unique

  documents     Document[]
  conversations Conversation[]
  voiceCalls    VoiceCall[]
  faqEntries    FaqEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("jurisdiction")
}

model Document {
  id             String       @id @default(uuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  url            String       @unique
  title          String?
  hash           String?      // for change detection
  /// MIME from crawl (e.g. text/html, application/pdf)
  mimeType       String?
  /// Classified at crawl for RAG soft penalties / meeting-dump gating
  docKind        DocumentKind?

  chunks         Chunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdictionId])
  @@index([docKind])

  // Table name
  @@map("documents")
}

model Chunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String   @db.Text
  embedding  Unsupported("vector(768)")
  heading    String?
  /// Character length of content (not tokenizer tokens)
  charCount  Int?
  /// 1-based PDF page where this chunk starts (null for HTML)
  pageStart  Int?
  /// 1-based PDF page where this chunk ends (null for HTML)
  pageEnd    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])

  // Table name
  @@map("chunks")
}

/// Precomputed English FAQ answers for instant widget replies.
model FaqEntry {
  id                  String       @id @default(uuid())
  jurisdictionId      String
  jurisdiction        Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  question            String       @db.Text
  normalizedQuestion  String
  answer              String       @db.Text
  sources             Json?
  /// Chat LLM that generated `answer`
  model               String?
  questionEmbedding   Unsupported("vector(768)")
  sourceUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurisdictionId, normalizedQuestion])
  @@index([jurisdictionId])
  @@map("faq_entries")
}

// Chat persistence: one conversation per thread, messages in order
model Conversation {
  id             String       @id @default(uuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  /// FAQ entry ids already served in this thread (cache used at most once)
  usedFaqIds     String[]     @default([])
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([jurisdictionId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user" | "agent"
  content        String       @db.Text
  /// UI locale when the user sent the message (e.g. en, es)
  language       String?
  vote           String?      // "up" | "down" when set
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  responseTime   Int?
  /// Structured citation chips for agent replies (JSON array)
  sources        Json?
  /// True when the agent reply came from a precomputed FAQ cache hit
  isFaqCache     Boolean      @default(false)

  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

/// Phone AI call log for internal margin tracking (not customer billing).
model VoiceCall {
  id             String       @id @default(uuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  /// OpenAI Realtime call_id
  externalCallId String       @unique
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  durationSec    Int?
  turnCount      Int          @default(0)
  toolCallCount  Int          @default(0)
  transcript     String?      @db.Text
  model          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdictionId])
  @@index([startedAt])
  @@map("voice_calls")
}