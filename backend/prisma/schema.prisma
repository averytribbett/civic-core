generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JurisdictionType {
  country
  state
  county
  city
  township
  village
}

/// Coarse document category for RAG soft re-ranking (citizen pages vs meeting dumps).
enum DocumentKind {
  html_page
  pdf
  agenda
  minutes
  other
}

model Jurisdiction {
  id            String @id @default(uuid())
  /// Widget/API source slug (e.g. chisago_county_mn); matches Conversation.source and Document.source
  source        String            @unique
  name          String
  type          JurisdictionType
  email         String
  phoneNumber   String?
  prompt        String            @db.Text
  /// When true, included in the weekly Cloud Run crawl-sync job
  enabled       Boolean           @default(false)
  /// Seed URL for crawls (e.g. https://www.chisagocountymn.gov/)
  crawlUrl      String?
  lastCrawlAt   DateTime?
  lastCrawlStatus String?
  lastCrawlError  String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("jurisdiction")
}

model Document {
  id          String   @id @default(uuid())
  url         String   @unique
  title       String?
  source      String?  // Jurisdiction.source slug (e.g. chisago_county_mn)
  hash        String?  // for change detection
  /// MIME from crawl (e.g. text/html, application/pdf)
  mimeType    String?
  /// Classified at crawl for RAG soft penalties / meeting-dump gating
  docKind     DocumentKind?

  chunks      Chunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([docKind])

  // Table name
  @@map("documents")
}

model Chunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String   @db.Text
  embedding  Unsupported("vector(768)")
  heading   String?
  tokens    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])

  // Table name
  @@map("chunks")
}

// Chat persistence: one conversation per thread, messages in order
model Conversation {
  id        String    @id @default(uuid())
  source    String    // Jurisdiction.source slug (e.g. chisago_county_mn)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([source])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user" | "agent"
  content        String       @db.Text
  /// UI locale when the user sent the message (e.g. en, es)
  language       String?
  vote           String?      // "up" | "down" when set
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  responseTime   Int?
  
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}